# Core Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Persistência e Broker
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lexicraft
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Provedores de Large Language Models (OpenCode Go - OpenAI-Compatible)
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_API_KEY=sk-your-opencode-go-key
# Endpoint público que lista os modelos disponíveis (catálogo dinâmico, sem hardcode)
OPENCODE_MODELS_URL=https://opencode.ai/zen/go/v1/models
# Modelo global fallback usado quando o ProfileConfig não define um model_name
DEFAULT_MODEL_NAME=deepseek-v4-flash

# Tabela estática de custos por 1M de tokens (USD) — usada pelo Motor de Isocusto
COST_PER_1M_PROMPT_TOKENS=0.15
COST_PER_1M_COMPLETION_TOKENS=0.60

# Parametrização Global de Limites de Sistema (Fallback)
MAX_BUDGET_USD_PER_TASK=2.50
MAX_TIME_SECONDS_PER_TASK=300
MAX_ITERATIONS_PER_TASK=3
